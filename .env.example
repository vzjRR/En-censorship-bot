# ============================================================================
# ENCLAVE RP — Moderation Control Platform
# Environment configuration template.
#
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file — it is already excluded via .gitignore.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin of the dashboard/API (scheme + host only, no path), used to
# build the OAuth2 redirect URI. In production this is the domain Cloudflare
# (or your reverse proxy) points at, e.g. APP_BASE_URL=https://enclaverp.cc
APP_BASE_URL=http://localhost:3000
# Optional mount path if the dashboard is served from a sub-path behind a
# reverse proxy instead of the domain root, e.g. for
# https://enclaverp.cc/censorship set BASE_PATH=/censorship
# (your proxy must forward the whole /censorship/* path through unchanged —
# do not strip the prefix, the app expects to see it). Leave empty for root.
BASE_PATH=

# --- Database ------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgres://enclave:changeme@localhost:5432/enclave_rp

# --- Sessions / Security -------------------------------------------------------
# Long, random secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Discord Application ---------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1544474462630449162
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# --- Platform Configuration (non-secret Discord IDs) -----------------------
PLATFORM_OWNER_ID=1303195553068482591
BOT_ID=1544474462630449162
STAFF_LOG_CHANNEL_ID=1539101062152069202
WARNING_CHANNEL_ID=1539103436308611082
BAN_CHANNEL_ID=1539102903745249372

# --- Localization ------------------------------------------------------------
TIMEZONE=Asia/Muscat

# --- Expiration Worker -------------------------------------------------------
# How often (ms) the worker checks for expired warnings/bans.
EXPIRATION_WORKER_INTERVAL_MS=60000

# --- Evidence storage --------------------------------------------------------
# "discord" stores evidence as Discord CDN attachments (default, no extra infra).
# "local" stores uploads on local disk under server/uploads (for development only).
EVIDENCE_STORAGE_DRIVER=discord
MAX_EVIDENCE_FILE_SIZE_MB=25
